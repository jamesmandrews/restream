# SRT listen port for incoming stream
SRT_PORT=9000

# SRT passphrase (10-79 characters, required)
# Camera/encoder must use the same passphrase to connect
# Connections without the correct passphrase are rejected
SRT_PASSPHRASE=change-me-to-something-secure

# Platform RTMP URL (include stream key)
# Examples:
#   rtmp://live.twitch.tv/app/live_xxxxxxxxxxxx
#   rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx
RTMP_URL=rtmp://live.twitch.tv/app/YOUR_STREAM_KEY

# Local nginx-rtmp relay URL (usually no need to change)
LOCAL_RTMP_URL=rtmp://nginx-rtmp/live/stream

# Fallback content type: "image" or "video"
FALLBACK_TYPE=image

# Path to fallback content file
FALLBACK_PATH=/app/fallback/brb.png

# How often to check SRT stream health (ms)
PROBE_INTERVAL_MS=3000

# Delay before switching to fallback after stream loss (ms)
SWITCH_DELAY_MS=5000
